{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "API_PORT",
        "WEBSOCKET_PUBLIC_URL",
        "WEBAPP_PORT",
        "BACKOFFICE_PORT",
        "DEFAULT_ADMIN_BOOTSTRAP_ENABLED",
        "DEFAULT_ADMIN_EMAIL",
        "DEFAULT_ADMIN_PASSWORD"
      ]
    },
    "dev:telegram": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true,
      "env": [
        "API_PORT",
        "WEBSOCKET_PUBLIC_URL",
        "WEBAPP_PORT",
        "BACKOFFICE_PORT",
        "DEFAULT_ADMIN_BOOTSTRAP_ENABLED",
        "DEFAULT_ADMIN_EMAIL",
        "DEFAULT_ADMIN_PASSWORD"
      ]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^check-types"],
      "outputs": []
    },
    "test:api": {
      "cache": false,
      "outputs": ["coverage/**"],
      "env": [
        "NODE_ENV",
        "API_HOST",
        "API_PORT",
        "API_TEST_ENABLED",
        "API_TEST_SEEDS",
        "MONGODB_URI",
        "MONGODB_DB",
        "TEST_TENANT_ID",
        "DEFAULT_ADMIN_BOOTSTRAP_ENABLED",
        "DEFAULT_ADMIN_EMAIL",
        "DEFAULT_ADMIN_PASSWORD",
        "AUTH_ACCESS_SECRET",
        "AUTH_REFRESH_SECRET",
        "CSRF_SECRET",
        "WEBSOCKET_TICKET_SECRET",
        "WEBSOCKET_PUBLIC_URL",
        "COOKIE_SECURE",
        "AGENT_INTERNAL_URL",
        "AGENT_SERVICE_TOKEN"
      ]
    },
    "test:e2e": {
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"],
      "env": [
        "E2E_ENABLED",
        "E2E_ADMIN_EMAIL",
        "E2E_ADMIN_PASSWORD",
        "E2E_USER_EMAIL",
        "E2E_USER_PASSWORD"
      ]
    },
    "boundaries": {
      "outputs": []
    },
    "format:check": {
      "outputs": []
    }
  }
}
