{
  "name": "stock42-monorepo-scaffolding",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "@playwright/test": "1.62.0",
    "@types/bun": "1.3.14",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.2.12",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "zod": "4.4.3"
  },
  "scripts": {
    "build": "turbo run build --filter=@stock42/webapp --filter=@stock42/backoffice",
    "start": "./run-all.sh",
    "dev": "./run-dev-all.sh",
    "update:env": "bun run scripts/update-env.ts",
    "check-types": "turbo run check-types",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:tools": "bun test scripts/update-env.test.ts",
    "test:api": "turbo run test:api --filter=@stock42/api",
    "test:e2e": "turbo run test:e2e --filter=@stock42/webapp --filter=@stock42/backoffice",
    "boundaries": "bun test scripts/check-boundaries.test.ts && bun run scripts/check-boundaries.ts",
    "secret-scan": "gitleaks git --redact=100 --log-opts=--all .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "bun audit"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "2.10.7",
    "typescript": "catalog:"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "hono": "4.12.34",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.17",
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
