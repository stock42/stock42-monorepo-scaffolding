NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3822

# Always point to an existing database. The scaffold never derives or creates a test database.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=stock42_existing

# Required for the idempotent platform administrator bootstrap.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# Use long, independent random values in real deployments.
AUTH_ACCESS_SECRET=replace-with-at-least-32-characters
AUTH_REFRESH_SECRET=replace-with-a-different-32-character-secret
CSRF_SECRET=replace-with-a-different-32-character-secret
WEBSOCKET_TICKET_SECRET=replace-with-a-different-32-character-secret

# Comma-separated origins or * for the requested permissive development default.
CORS_ORIGINS=*
COOKIE_SECURE=false
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

AGENT_INTERNAL_URL=http://127.0.0.1:4100
AGENT_SERVICE_TOKEN=replace-with-an-internal-service-token-at-least-32-characters

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_LOGIN_REQUESTS=10
RATE_LIMIT_AGENT_REQUESTS=20

# Integration tests must opt in and use this exact database.
API_TEST_ENABLED=false
API_TEST_SEEDS=false
TEST_TENANT_ID=
