NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3822

# Always point to an existing database. The scaffold never derives or creates a test database.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=stock42_existing

# Explicit opt-in for the idempotent platform administrator bootstrap.
DEFAULT_ADMIN_BOOTSTRAP_ENABLED=false
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# Use long, independent random values in real deployments.
AUTH_ACCESS_SECRET=
AUTH_REFRESH_SECRET=
CSRF_SECRET=
WEBSOCKET_TICKET_SECRET=
WEBSOCKET_PUBLIC_URL=ws://127.0.0.1:3822/ws

# Comma-separated origins or * for the requested permissive development default.
CORS_ORIGINS=*
COOKIE_SECURE=false
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

AGENT_INTERNAL_URL=http://127.0.0.1:4100
ALLOW_PUBLIC_AGENT_URL=false
AGENT_SERVICE_TOKEN=

# Exact proxy IPs allowed to supply X-Forwarded-For. Empty means trust none.
TRUSTED_PROXIES=127.0.0.1,::1

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_LOGIN_REQUESTS=10
RATE_LIMIT_AGENT_REQUESTS=20

# Persistent email marketing spooler. Delivery remains off until explicitly enabled.
EMAIL_SPOOLER_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
EMAIL_SPOOLER_INTERVAL_MS=60000
EMAIL_SPOOLER_BATCH_SIZE=25
EMAIL_SPOOLER_MAX_ATTEMPTS=3
EMAIL_SPOOLER_LEASE_MS=300000

# Integration tests must opt in and use this exact database.
API_TEST_ENABLED=false
API_TEST_SEEDS=false
TEST_TENANT_ID=
