NODE_ENV=development
AGENT_HOST=127.0.0.1
AGENT_PORT=4100

# Must be the same existing database configured for the API.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=stock42_existing

AGENT_SERVICE_TOKEN=replace-with-the-same-internal-token-at-least-32-characters
DEEPSEEK_API_KEY=replace-with-provider-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=high

AGENT_LAUNCH_INTERVAL_MS=1000
AGENT_SUPERVISOR_INTERVAL_MS=2000
AGENT_GLOBAL_CONCURRENCY=4
AGENT_TENANT_CONCURRENCY=2
AGENT_HEARTBEAT_MS=5000
AGENT_INACTIVITY_TIMEOUT_MS=120000
AGENT_RUN_TIMEOUT_MS=900000
AGENT_CANCEL_GRACE_MS=10000

# Local bytes only; MongoDB stores metadata, never base64 blobs.
UPLOAD_STORAGE_PATH=./uploads
ARTIFACT_STORAGE_PATH=./artifacts
MAX_UPLOAD_BYTES=10485760

# Optional. The token is never logged.
TELEGRAM_BOT_TOKEN=

# Safe default for direct execution and local development. The production
# `start` script enables polling only when an inbound Telegram adapter exists.
TELEGRAM_POLLING_ENABLED=false
